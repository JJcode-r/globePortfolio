.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.*.local
*.env

# ── Vite ───────────────────────────────────────────────────
.vite/
vite.config.ts.timestamp-*

# ── TypeScript ──────────────────────────────────────────────
*.tsbuildinfo

# ── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Runtime & process files ─────────────────────────────────
