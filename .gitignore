# ============================================================
#  Globe Portfolio — .gitignore
#  Vite · React 19 · TypeScript · Tailwind CSS · GSAP
# ============================================================

# ── Dependencies ────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ── Build outputs ───────────────────────────────────────────
dist/
dist-ssr/
build/
out/

# ── Environment & secrets ───────────────────────────────────
# Never commit API keys, tokens, or service credentials.
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.*.local
*.env

# ── Vite ───────────────────────────────────────────────────
.vite/
vite.config.ts.timestamp-*

# ── TypeScript ──────────────────────────────────────────────
*.tsbuildinfo

# ── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Runtime & process files ─────────────────────────────────
pids/
*.pid
*.seed
*.pid.lock

# ── Test & coverage ─────────────────────────────────────────
coverage/
*.lcov
.nyc_output/
/cypress/videos/
/cypress/screenshots/

# ── Caches ──────────────────────────────────────────────────
.cache/
.eslintcache
.stylelintcache
.parcelcache/

# ── Temporary files ─────────────────────────────────────────
*.tmp
*.temp
.temp/
.tmp/
*.tgz
*.zip
*.tar.gz

# ── Editor: VS Code ─────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# ── Editor: JetBrains (WebStorm / IntelliJ) ─────────────────
.idea/
*.iml

# ── Editor: Misc ────────────────────────────────────────────
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# ── OS: macOS ───────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride

# ── OS: Windows ─────────────────────────────────────────────
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ── OS: Linux ───────────────────────────────────────────────
*~

# ── Deployment platforms ────────────────────────────────────
.vercel
.netlify
.wrangler/

# ── Storybook ───────────────────────────────────────────────
storybook-static/

# ── Package manager artefacts ───────────────────────────────
# Commit the lock file that matches your package manager.
# Uncomment the lines for managers you are NOT using:
# yarn.lock
# pnpm-lock.yaml
# package-lock.json

# ── Local dev overrides ──────────────────────────────────────
*.local
