*.pid
*.seed
*.pid.lock

# ── Test & coverage ─────────────────────────────────────────
coverage/
*.lcov
.nyc_output/
/cypress/videos/
/cypress/screenshots/

# ── Caches ──────────────────────────────────────────────────
.cache/
.eslintcache
.stylelintcache
.parcelcache/

# ── Temporary files ─────────────────────────────────────────
*.tmp
*.temp
.temp/
.tmp/
*.tgz
*.zip
*.tar.gz

# ── Editor: VS Code ─────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# ── Editor: JetBrains (WebStorm / IntelliJ) ─────────────────
.idea/
*.iml

# ── Editor: Misc ────────────────────────────────────────────
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# ── OS: macOS ───────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride

# ── OS: Windows ─────────────────────────────────────────────
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ── OS: Linux ───────────────────────────────────────────────
*~

# ── Deployment platforms ────────────────────────────────────
.vercel
.netlify
.wrangler/

# ── Storybook ───────────────────────────────────────────────
storybook-static/

